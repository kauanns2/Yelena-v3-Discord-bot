# Yelena V3 — referência de variáveis (SEM valores secretos)

YELENA_ENVIRONMENT=production
YELENA_LOG_LEVEL=INFO

# HTTP
PORT=8000
YELENA_HOST=0.0.0.0
YELENA_PORT=8000
YELENA_HTTP_API_KEY=

# Discord (Módulo 17 — Bridge). Deixe vazio para só API HTTP.
DISCORD_TOKEN=

# Continuidade (disco local / volume)
YELENA_CONTINUITY_DIR=.yelena_continuity

# Secrets via Configuration
# YELENA_SECRET_OPENAI_API_KEY=
