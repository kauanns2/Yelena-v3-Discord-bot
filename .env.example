# Yelena V3 — variáveis de ambiente (sem secrets reais)

# Ambiente
YELENA_ENVIRONMENT=production
YELENA_LOG_LEVEL=INFO

# HTTP (Render define PORT automaticamente)
PORT=8000
YELENA_HOST=0.0.0.0
YELENA_PORT=8000

# Proteção opcional da API HTTP (deixe vazio para desabilitar)
YELENA_HTTP_API_KEY=

# NOTA:
# Tokens Discord, OpenAI e demais secrets ficam no INTERMEDIÁRIO
# ou no painel de secrets do host (Render). Nunca commitar valores reais.
